    {
      "name": "C5-saldo-negatif",
      "description": "Purchase above the balance (negative), then recovery with a top up and more discounted purchases",
      "ops": [
        { "op": "topup", "amount": "5000" },
        { "op": "transact", "product_id": "P001", "quantity": 1, "discount_code": "NONE" },
        { "op": "topup", "amount": "20000" },
        { "op": "transact", "product_id": "P002", "quantity": 1, "discount_code": "DISC10" },
        { "op": "transact", "product_id": "P004", "quantity": 1, "discount_code": "COMBO" }
