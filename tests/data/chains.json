        { "op": "topup", "amount": "1000.5" }, { "op": "transact", "product_id": "P005", "quantity": 1, "discount_code": "DISC10" },
        { "op": "topup", "amount": "1000.5" }, { "op": "transact", "product_id": "P005", "quantity": 1, "discount_code": "DISC10" },
        { "op": "topup", "amount": "1000.5" }, { "op": "transact", "product_id": "P005", "quantity": 1, "discount_code": "DISC10" },
        { "op": "topup", "amount": "1000.5" }, { "op": "transact", "product_id": "P005", "quantity": 1, "discount_code": "DISC10" },
        { "op": "topup", "amount": "1000.5" }, { "op": "transact", "product_id": "P005", "quantity": 1, "discount_code": "DISC10" },
        { "op": "topup", "amount": "1000.5" }, { "op": "transact", "product_id": "P005", "quantity": 1, "discount_code": "DISC10" },
        { "op": "topup", "amount": "1000.5" }, { "op": "transact", "product_id": "P005", "quantity": 1, "discount_code": "DISC10" },
        { "op": "topup", "amount": "1000.5" }, { "op": "transact", "product_id": "P005", "quantity": 1, "discount_code": "DISC10" },
