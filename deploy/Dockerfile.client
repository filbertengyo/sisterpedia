# syntax=docker/dockerfile:1
ARG GO_VERSION=1.27

FROM golang:${GO_VERSION}-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/clientsvc ./cmd/clientsvc

FROM alpine:3.21
# secret key hanya hidup di volume /client_data milik service ini
RUN adduser -D -u 10001 app && mkdir -p /client_data /app && chown app:app /client_data
USER app
WORKDIR /app
COPY --from=build /out/clientsvc /app/clientsvc
EXPOSE 8001
ENTRYPOINT ["/app/clientsvc"]
