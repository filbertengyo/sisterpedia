# Salin ke .env (jangan commit .env). Tidak boleh ada kunci/secret di sini.

# --- server (cmd/server) ---
SERVER_ADDR=:8000
DB_PATH=server_data/shop.db
CATALOG_PATH=data/catalog.json
ALLOWED_PROFILES=p1,p2
MAX_BODY_BYTES=8388608

# --- client service (cmd/clientsvc) ---
LISTEN_ADDR=:8001
SERVER_URL=http://localhost:8000
ALLOWED_ORIGIN=http://localhost:3000
CLIENT_DATA_DIR=client_data
AUDIT=0

# --- CKKS (dibaca pkg/ckks dari config/profiles.yaml) ---
CKKS_PROFILE=p1
CKKS_PROFILES_FILE=config/profiles.yaml

# --- web (Next.js) ---
NEXT_PUBLIC_CLIENT_API=http://localhost:8001
NEXT_PUBLIC_MOCK=0
