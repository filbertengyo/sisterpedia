# Copy to .env (never commit .env). No keys or secrets belong here.

# --- server (cmd/server) ---
SERVER_ADDR=:8000
DB_PATH=server_data/shop.db
CATALOG_PATH=data/catalog.json
ALLOWED_PROFILES=p1,p2
# Activate (public key + relin key) can reach ~8.3 MiB after Base64 on profile p2.
MAX_BODY_BYTES=16777216
# Origin of the web GUI; the browser calls the server directly (CORS).
ALLOWED_ORIGIN=http://localhost:3000

# --- CKKS (read by pkg/ckks from config/profiles.yaml) ---
CKKS_PROFILE=p1
CKKS_PROFILES_FILE=config/profiles.yaml

# --- web (Next.js) ---
# Address of the server as seen from the browser.
NEXT_PUBLIC_SERVER_API=http://localhost:8000
NEXT_PUBLIC_MOCK=0
